# SoundCloud Configuration
SOUNDCLOUD_USERNAME=your_username
# Optional: SOUNDCLOUD_CLIENT_ID will be auto-extracted if not set
# For private likes, get your OAuth token from browser cookies
SOUNDCLOUD_OAUTH_TOKEN=your_oauth_token_here

# Apple Music Downloader (optional)
APPLE_MUSIC_REPO=../apple-music-downloader

# Sync Settings
INITIAL_DOWNLOAD=10
LIMIT=200
